;; groundwork-shaped-json: data that crosses an edge comes back as what it was.
;; One tree for both languages: source-code/groundwork_shaped_json/, one namespace each.
{:paths ["source-code"]

 :deps
 {metosin/malli    {:mvn/version "0.20.3"}
  metosin/jsonista {:mvn/version "1.0.2"}}

 :aliases
 {;; the JVM tests:  clojure -X:test
  :test {:extra-paths ["test-code"]
         :extra-deps  {io.github.cognitect-labs/test-runner {:git/tag "v0.5.1" :git/sha "dfb30dd"}
                       ;; malli.generator's, for the generated round trips
                       org.clojure/test.check               {:mvn/version "1.1.3"}}
         :exec-fn     cognitect.test-runner.api/test
         :exec-args   {:dirs ["test-code"]}}
  ;; the browser tests, through shadow-cljs:  npm install && npx shadow-cljs compile test
  :cljs {:extra-paths ["test-code"]
         :extra-deps  {thheller/shadow-cljs    {:mvn/version "3.5.10"}
                       org.clojure/test.check {:mvn/version "1.1.3"}}}}}
